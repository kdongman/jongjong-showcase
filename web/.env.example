# Public Supabase client credentials (never put service-role or LIVEKIT_API_SECRET here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit WebSocket URL returned by couple-booth-token (also used as fallback if token response omits url)
VITE_LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST

# Canonical web app origin for auth redirects (must be HTTPS in production)
VITE_APP_URL=https://jongjong-app.vercel.app

# Enables post-capture cutout composition for host-selected Same Space sessions.
# Keep false until the deployed app can load the MediaPipe model/WASM assets.
VITE_SAME_SPACE_MODE_ENABLED=false
